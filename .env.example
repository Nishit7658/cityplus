# ==========================================
# CityPulse Environment Variables Template
# ==========================================

# ----------------
# Backend Env Vars
# ----------------
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Supabase / Render / Local PostGIS)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citypulse

# Meta WhatsApp Cloud API Credentials (See WHATSAPP_SETUP.md)
WHATSAPP_TOKEN=your_meta_whatsapp_temporary_or_permanent_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
VERIFY_TOKEN=your_custom_webhook_verify_token

# -----------------
# Frontend Env Vars
# -----------------
# Next.js Public Server URL
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
