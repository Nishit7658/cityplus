# ====================================================================
# CityPulse (VMC) — Backend Environment Configuration
# All services support 100% FREE tiers with zero credit card required
# ====================================================================

PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000

# --------------------------------------------------------------------
# 1. DATABASE (PostgreSQL + PostGIS)
# Default: Local PostgreSQL. (Cloud Free Tier: Supabase or Neon.tech)
# --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citypulse

# --------------------------------------------------------------------
# 2. JWT AUTHENTICATION SECRET
# --------------------------------------------------------------------
JWT_SECRET=vmc_citypulse_gov_jwt_secret_key_2026

# --------------------------------------------------------------------
# 3. TELEGRAM BOT API (100% Free — Instant Setup via @BotFather)
# How to get: Open Telegram -> Search @BotFather -> send /newbot
# --------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=vmc_telegram_webhook_secret_2026

# --------------------------------------------------------------------
# 4. WHATSAPP CLOUD API (Meta for Developers — 1,000 Free msgs/mo)
# How to get: https://developers.facebook.com -> Create App -> WhatsApp
# --------------------------------------------------------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=my_custom_secret_verify_token_123
META_APP_SECRET=
